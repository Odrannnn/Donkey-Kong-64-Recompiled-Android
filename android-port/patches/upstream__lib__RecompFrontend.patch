         }
         case EventType::Focus: {
             const EventFocus &event = std::get<EventFocus>(e.variant);
+#ifdef __ANDROID__
+            // SDL's Android backend does not show the software keyboard until
+            // text input is explicitly started. RmlUi owns the actual field;
